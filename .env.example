# ==========================================
# CollabDraw Environment Variables Template
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Optional for local dev - falls back to resilient in-memory storage)
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/collabdraw?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/collabdraw

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
